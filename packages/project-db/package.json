{
  "name": "@heron/project-db",
  "version": "0.6.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./live-schema": "./src/live-schema.ts",
    "./live-node": "./src/live-node.ts",
    "./live-protocol": "./src/live-protocol.ts",
    "./live-template": "./src/live-template.ts",
    "./protocol": "./src/protocol.ts",
    "./node": "./src/node.ts",
    "./template": "./src/template.ts",
    "./mixer-schema": "./src/mixer-schema.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && pnpm db:check",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.live.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts && drizzle-kit check --config drizzle.live.config.ts",
    "bench": "vitest bench --run",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__",
    "test:coverage": "vitest run --coverage src/__tests__"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@heron/contracts": "workspace:*",
    "@heron/project-model": "workspace:*",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@types/emscripten": "1.41.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.11",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
