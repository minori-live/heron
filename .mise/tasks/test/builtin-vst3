#!/usr/bin/env bash
#MISE description="Run smoke tests for the bundled VST3 plug-ins"
#MISE depends=["native:debug"]
set -euo pipefail

pnpm --filter @heron/desktop test:builtin-vst3

# This host integration test loads the prepared artifact, without plugin sources.
cargo test --locked --target "$(cargo xtask host-target)" \
  -p heron-audio-host --test builtin_eq_bundle -- --ignored --test-threads=1
