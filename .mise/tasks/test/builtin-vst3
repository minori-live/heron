#!/usr/bin/env bash
#MISE description="Run smoke tests for the bundled VST3 plug-ins"
#MISE depends=["native:debug"]
set -euo pipefail

pnpm --filter @heron/desktop test:builtin-vst3

# Functional host integration against prepared artifacts (no wall-clock pacing).
cargo test --locked --target "$(node scripts/rust-target.ts)" \
  -p heron-audio-host --test builtin_eq_bundle \
  -- --ignored --test-threads=1 --nocapture

# Paced Revox realtime pitch measurements are a local performance gate only.
# Run `mise run test:revox-perf` after packaging or preparing plug-ins.
# CI must never set HERON_REVOX_PERF or invoke that task.
