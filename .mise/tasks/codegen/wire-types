#!/usr/bin/env bash
#MISE description="Regenerate the TypeScript declarations for the native wire types"
set -euo pipefail

# The Rust protocol owns the wire shape. Regenerating is deterministic, so CI
# re-runs this and fails when the committed declarations differ.
export TS_RS_EXPORT_DIR="$PWD/apps/desktop/src/main/audio-host/wire/generated"
rm -rf "$TS_RS_EXPORT_DIR"
mkdir -p "$TS_RS_EXPORT_DIR"
cargo test -p heron-dsp-runtime --features ts-export --lib export_typescript -- --nocapture
