{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "security:minimumReleaseAgeNpm",
    "schedule:weekly"
  ],
  "prConcurrentLimit": 2,
  "separateMajorMinor": false,
  "groupSingleUpdates": true,
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "lock"
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "schedule": ["* * 1 * *"]
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "update"
    }
  ]
}
